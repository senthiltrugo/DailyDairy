generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Farmer {
  id                    String                @id @default(uuid()) @db.Uuid
  name                  String
  phone                 String
  village               String
  district              String
  latitude              Decimal?              @db.Decimal(10, 7)
  longitude             Decimal?              @db.Decimal(10, 7)
  bankAccountNumber     String                @map("bank_account_number")
  ifscCode              String                @map("ifsc_code")
  numberOfCattle        Int                   @map("number_of_cattle")
  avgDailyMilkLitres    Decimal               @db.Decimal(10, 2) @map("avg_daily_milk_litres")
  createdAt             DateTime              @default(now()) @map("created_at")
  milkProcurementRecord MilkProcurementRecord[]
  collectionRecords     CollectionRecord[]
  farmerCenterLinks     FarmerCollectionCenter[]

  @@map("farmers")
}

model MilkProcurementRecord {
  id            String   @id @default(uuid()) @db.Uuid
  farmerId      String   @db.Uuid @map("farmer_id")
  date          DateTime @db.Date
  quantityLitres Decimal @db.Decimal(10, 2) @map("quantity_litres")
  fatPercentage Decimal  @db.Decimal(5, 2) @map("fat_percentage")
  snfPercentage Decimal  @db.Decimal(5, 2) @map("snf_percentage")
  pricePerLitre Decimal  @db.Decimal(10, 2) @map("price_per_litre")
  totalAmount   Decimal  @db.Decimal(12, 2) @map("total_amount")
  createdAt     DateTime @default(now()) @map("created_at")
  farmer        Farmer   @relation(fields: [farmerId], references: [id], onDelete: Cascade)

  @@index([farmerId], map: "idx_milk_procurement_farmer_id")
  @@index([date], map: "idx_milk_procurement_date")
  @@map("milk_procurement_records")
}

model CollectionCenter {
  id            String                   @id @default(uuid()) @db.Uuid
  name          String
  location      String
  capacityLitres Decimal                 @db.Decimal(12, 2) @map("capacity_litres")
  managerName   String                   @map("manager_name")
  latitude      Decimal?                 @db.Decimal(10, 7)
  longitude     Decimal?                 @db.Decimal(10, 7)
  createdAt     DateTime                 @default(now()) @map("created_at")
  records       CollectionRecord[]
  farmerLinks   FarmerCollectionCenter[]
  dispatches    MilkDispatch[]

  @@map("collection_centers")
}

model CollectionRecord {
  id          String           @id @default(uuid()) @db.Uuid
  farmerId    String           @db.Uuid @map("farmer_id")
  centerId    String           @db.Uuid @map("center_id")
  quantity    Decimal          @db.Decimal(10, 2)
  timestamp   DateTime         @default(now())
  createdAt   DateTime         @default(now()) @map("created_at")
  farmer      Farmer           @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  center      CollectionCenter @relation(fields: [centerId], references: [id], onDelete: Cascade)

  @@index([centerId], map: "idx_collection_records_center_id")
  @@index([farmerId], map: "idx_collection_records_farmer_id")
  @@index([timestamp], map: "idx_collection_records_timestamp")
  @@map("collection_records")
}

model FarmerCollectionCenter {
  id                    String           @id @default(uuid()) @db.Uuid
  farmerId              String           @db.Uuid @map("farmer_id")
  centerId              String           @db.Uuid @map("center_id")
  distanceKm            Decimal?         @db.Decimal(10, 3) @map("distance_km")
  assignedAt            DateTime         @default(now()) @map("assigned_at")
  farmer                Farmer           @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  center                CollectionCenter @relation(fields: [centerId], references: [id], onDelete: Cascade)

  @@unique([farmerId], map: "uniq_farmer_center_assignment")
  @@index([centerId], map: "idx_farmer_center_assignment_center_id")
  @@map("farmer_collection_centers")
}

model Manufacturer {
  id                String         @id @default(uuid()) @db.Uuid
  name              String
  location          String
  capacityPerDay    Decimal        @db.Decimal(12, 2) @map("capacity_per_day")
  supportedProducts Json           @map("supported_products")
  createdAt         DateTime       @default(now()) @map("created_at")
  dispatches        MilkDispatch[]

  @@map("manufacturers")
}

model Product {
  id               String      @id @default(uuid()) @db.Uuid
  name             String
  unit             String
  sellingPrice     Decimal     @db.Decimal(12, 2) @map("selling_price")
  createdAt        DateTime    @default(now()) @map("created_at")
  inventoryBatches Inventory[]
  stockMovements   StockMovement[]
  orders           Order[]
  subscriptions    Subscription[]

  @@unique([name], map: "uniq_products_name")
  @@map("products")
}

model Inventory {
  id                String         @id @default(uuid()) @db.Uuid
  productId         String         @db.Uuid @map("product_id")
  quantityAvailable Decimal        @db.Decimal(12, 3) @map("quantity_available")
  batchId           String         @map("batch_id")
  expiryDate        DateTime?      @db.Date @map("expiry_date")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  product           Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockMovements    StockMovement[]

  @@index([productId], map: "idx_inventory_product_id")
  @@index([batchId], map: "idx_inventory_batch_id")
  @@unique([productId, batchId], map: "uniq_inventory_product_batch")
  @@map("inventory")
}

model StockMovement {
  id           String     @id @default(uuid()) @db.Uuid
  productId    String     @db.Uuid @map("product_id")
  inventoryId  String?    @db.Uuid @map("inventory_id")
  batchId      String?    @map("batch_id")
  movementType String     @map("movement_type")
  quantity     Decimal    @db.Decimal(12, 3)
  source       String?
  note         String?
  createdAt    DateTime   @default(now()) @map("created_at")
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory    Inventory? @relation(fields: [inventoryId], references: [id], onDelete: SetNull)

  @@index([productId], map: "idx_stock_movements_product_id")
  @@index([movementType], map: "idx_stock_movements_movement_type")
  @@map("stock_movements")
}

model Customer {
  id            String         @id @default(uuid()) @db.Uuid
  type          String
  name          String
  phone         String
  address       String
  createdAt     DateTime       @default(now()) @map("created_at")
  orders        Order[]
  subscriptions Subscription[]

  @@index([type], map: "idx_customers_type")
  @@unique([phone], map: "uniq_customers_phone")
  @@map("customers")
}

model Subscription {
  id             String    @id @default(uuid()) @db.Uuid
  customerId     String    @db.Uuid @map("customer_id")
  productId      String    @db.Uuid @map("product_id")
  quantityPerDay Decimal   @db.Decimal(12, 3) @map("quantity_per_day")
  startDate      DateTime  @db.Date @default(now()) @map("start_date")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  customer       Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product        Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  orders         Order[]

  @@index([customerId], map: "idx_subscriptions_customer_id")
  @@index([productId], map: "idx_subscriptions_product_id")
  @@index([isActive], map: "idx_subscriptions_is_active")
  @@map("subscriptions")
}

model Order {
  id             String        @id @default(uuid()) @db.Uuid
  customerId     String        @db.Uuid @map("customer_id")
  productId      String        @db.Uuid @map("product_id")
  subscriptionId String?       @db.Uuid @map("subscription_id")
  quantity       Decimal       @db.Decimal(12, 3)
  price          Decimal       @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  orderDate      DateTime      @db.Date @map("order_date")
  source         String        @default("MANUAL")
  createdAt      DateTime      @default(now()) @map("created_at")
  customer       Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product        Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([customerId], map: "idx_orders_customer_id")
  @@index([productId], map: "idx_orders_product_id")
  @@index([orderDate], map: "idx_orders_order_date")
  @@unique([subscriptionId, orderDate], map: "uniq_subscription_daily_order")
  @@map("orders")
}

model MilkDispatch {
  id                 String           @id @default(uuid()) @db.Uuid
  centerId           String           @db.Uuid @map("center_id")
  manufacturerId     String           @db.Uuid @map("manufacturer_id")
  quantity           Decimal          @db.Decimal(12, 2)
  date               DateTime         @db.Date
  paneerOutputKg     Decimal          @db.Decimal(12, 3) @map("paneer_output_kg")
  gheeOutputKg       Decimal          @db.Decimal(12, 3) @map("ghee_output_kg")
  createdAt          DateTime         @default(now()) @map("created_at")
  center             CollectionCenter @relation(fields: [centerId], references: [id], onDelete: Cascade)
  manufacturer       Manufacturer     @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)

  @@index([centerId], map: "idx_milk_dispatch_center_id")
  @@index([manufacturerId], map: "idx_milk_dispatch_manufacturer_id")
  @@index([date], map: "idx_milk_dispatch_date")
  @@map("milk_dispatches")
}
