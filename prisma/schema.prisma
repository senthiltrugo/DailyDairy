generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Farmer {
  id                    String                @id @default(uuid()) @db.Uuid
  name                  String
  phone                 String
  village               String
  district              String
  bankAccountNumber     String                @map("bank_account_number")
  ifscCode              String                @map("ifsc_code")
  numberOfCattle        Int                   @map("number_of_cattle")
  avgDailyMilkLitres    Decimal               @db.Decimal(10, 2) @map("avg_daily_milk_litres")
  createdAt             DateTime              @default(now()) @map("created_at")
  milkProcurementRecord MilkProcurementRecord[]

  @@map("farmers")
}

model MilkProcurementRecord {
  id            String   @id @default(uuid()) @db.Uuid
  farmerId      String   @db.Uuid @map("farmer_id")
  date          DateTime @db.Date
  quantityLitres Decimal @db.Decimal(10, 2) @map("quantity_litres")
  fatPercentage Decimal  @db.Decimal(5, 2) @map("fat_percentage")
  snfPercentage Decimal  @db.Decimal(5, 2) @map("snf_percentage")
  pricePerLitre Decimal  @db.Decimal(10, 2) @map("price_per_litre")
  totalAmount   Decimal  @db.Decimal(12, 2) @map("total_amount")
  createdAt     DateTime @default(now()) @map("created_at")
  farmer        Farmer   @relation(fields: [farmerId], references: [id], onDelete: Cascade)

  @@index([farmerId], map: "idx_milk_procurement_farmer_id")
  @@index([date], map: "idx_milk_procurement_date")
  @@map("milk_procurement_records")
}
